# ── 서버 (apps/api) ──────────────────────────────
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL (로컬 Postgres, Supabase, Neon 등)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/healix

# OpenAI — 둘 중 하나만 있으면 됩니다
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# (Replit에서 쓰던 이름도 그대로 지원)
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=

# Google 로그인 (OIDC)
# Google Cloud Console → OAuth 클라이언트 → 승인된 리디렉션 URI:
#   http://localhost:5173/api/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ISSUER_URL=https://accounts.google.com

# 웹 앱 주소 (CORS 허용 목록, 쉼표로 여러 개)
WEB_ORIGIN=http://localhost:5173

# ── 모바일 (apps/mobile) ─────────────────────────
# 휴대폰 Expo Go에서 접속할 때는 PC의 LAN IP를 쓰세요 (예: http://192.168.0.10:3001)
EXPO_PUBLIC_API_URL=http://localhost:3001
